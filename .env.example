# Copy to .env and fill in. .env is git-ignored — never commit it.
# Restricted Stripe key needs write access to: Products, Prices, Payment Links, Webhook Endpoints.
STRIPE_SECRET_KEY=rk_live_xxx

# From the Supabase dashboard -> Project Settings -> API
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Personal access token from https://supabase.com/dashboard/account/tokens
# Only needed so the setup script can write STRIPE_WEBHOOK_SECRET into Supabase Secrets.
SUPABASE_ACCESS_TOKEN=sbp_xxx

# These are for scripts/stripe-setup.sh, which builds the Stripe objects from
# scratch on a NEW account. It creates fresh objects every run, so running it
# against the live account leaves you with a second payment link nobody uses.
